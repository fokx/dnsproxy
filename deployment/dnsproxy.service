[Unit]
Description=dnsproxy - High-Performance DNS Proxy Server
Documentation=https://github.com/fokx/dnsproxy
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dnsproxy
Group=dnsproxy
ExecStart=/usr/local/bin/dnsproxy --config /etc/dnsproxy/config.toml
Restart=on-failure
RestartSec=3s
LimitNOFILE=65535

# Security sandbox & capabilities
# CAP_NET_BIND_SERVICE allows binding to privileged port 53 without root privileges
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
NoNewPrivileges=true
ReadWritePaths=/var/cache/dnsproxy /tmp

[Install]
WantedBy=multi-user.target
